# Brief nach Berlin — Environment Variables Template
# Copy to .env.local and fill in your keys. This file is safe to commit.

# Mistral AI — letter generation, content moderation, and voice transcription (Voxtral)
# Models in use (source of truth: web/src/lib/mistral.ts MISTRAL_MODELS):
#   - mistral-medium-latest        (letter generation)
#   - mistral-moderation-latest    (input + output moderation)
#   - voxtral-mini-latest          (audio transcription, Voxtral Mini Transcribe 2.0)
# Get your key at: https://console.mistral.ai → API Keys → Create new key
# DSGVO note: in the Mistral console, verify that "Use my data to train models"
# is disabled for this workspace (Settings → Data sharing).
MISTRAL_API_KEY=

# Brevo (transactional email delivery — single send per request, no list)
# Get your key at: https://app.brevo.com → Settings → SMTP & API → API Keys
# DSGVO note: Open & Click tracking is disabled at the Brevo account level
# (Senders, Domains & Dedicated IPs → Tracking). Verified disabled on 2026-06-11.
# If you ever switch accounts, re-disable both toggles before sending live mail.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Feature-Flag für den automatisierten 3-Tage-Followup nach jeder Brief-Erstellung.
# Nur wenn exakt auf "true" gesetzt, wird via Brevo `scheduledAt` (~72h später)
# eine zweite Mail eingequeut. Erlaubt schnelle Notabschaltung ohne Deploy.
BREVO_FOLLOWUP_ENABLED=

# Salt für den In-Memory Rate-Limiter (lib/rateLimit.ts hashIdentifier).
# DSGVO M7: IP- und E-Mail-Werte werden vor Verwendung als Bucket-Key gehasht,
# damit die rohen Identifier nicht in der Map liegen. Wenn nicht gesetzt, nutzt
# der Limiter einen pro-Prozess-Zufalls-Salt — funktioniert, ist aber bei jedem
# Cold-Start neu (in-memory Buckets sind eh per-instance).
RATE_LIMIT_SALT=

# Kontakt-E-Mail des Gründers — erscheint als Reply-To in Follow-up-Mails,
# als Feedback-Link im Success-Screen und in den E-Mail-Footern.
# Wird von web/src/lib/contact.ts als CONTACT.email und in config.ts als
# FOUNDER_EMAIL exportiert. Fallback (kein .env.local): thomas_lorenz@posteo.de.
THOMAS_MAIL=

# --- 999.6 Ebenen-Routing (Bund/Land/Kommune) -------------------------------
# Wave-3-Kill-Switch: nur wenn exakt "true", klassifiziert Mistral das Anliegen
# auf eine Ebene und der Wizard zeigt den Ebene-Auswahl-Step. Bei "false"
# läuft der heutige Bund-only-Flow unverändert.
LANDTAG_ROUTING_ENABLED=false

# Wave-4-Kill-Switch (separat von LANDTAG_ROUTING_ENABLED): nur wenn exakt
# "true", bekommt der Brief-Prompt Land-/Kommune-spezifische Blöcke. Bei
# "false" nutzen alle Ebenen den heutigen Bund-Prompt (degradiert, nie kaputt).
LETTER_PROMPT_LEVEL_AWARE=false

# HMAC-Secret für den kurzlebigen Routing-Prefetch-Token (15 min TTL).
# Optional: fällt auf FEEDBACK_TOKEN_SECRET zurück, wenn nicht gesetzt.
ROUTING_TOKEN_SECRET=
