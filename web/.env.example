# Brief-nach-Berlin — Environment Variables Template
# Copy to .env.local and fill in your keys. This file is safe to commit.

# Supabase — Startseite, Zähler, Feedback, Kartensignale und Kampagnen.
# Für lokale Entwicklung eigene Entwicklungszugänge verwenden.
# Service-Role-Key nur serverseitig; niemals mit NEXT_PUBLIC_ prefixen.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signiert Feedback- und persönliche Löschlinks (Pflicht für Brief-Mails).
# Einen eigenen, zufälligen geheimen Wert setzen und stabil halten.
FEEDBACK_TOKEN_SECRET=

# Separates HMAC-Secret für die bei Bewertungen gespeicherten IP-Hashes.
# Ohne diesen Wert verweigert submitReviewAction den Schreibzugriff.
REVIEW_IP_SALT=

# Optional separates Secret für Kampagnen-Verwaltungssitzungen.
# Ohne Variable wird SUPABASE_SERVICE_ROLE_KEY verwendet. Bei Nutzung einkommentieren
# und mit einem eigenen zufälligen Wert füllen; nicht als leeren Wert setzen.
# CAMPAIGN_SESSION_SECRET=

# Mistral AI — letter generation, public campaign moderation, and voice transcription (Voxtral)
# Models in use (source of truth: web/src/lib/mistral.ts MISTRAL_MODELS):
#   - mistral-large-latest         (personal letter generation and variants)
#   - mistral-moderation-latest    (public campaign text moderation only)
#   - voxtral-mini-latest          (audio transcription, Voxtral Mini Transcribe 2.0)
#   - mistral-small-latest         (political-level routing)
# Get your key at: https://console.mistral.ai → API Keys → Create new key
# DSGVO note: in the Mistral console, verify that "Use my data to train models"
# is disabled for this workspace (Settings → Data sharing).
MISTRAL_API_KEY=

# Brevo (transactional email delivery — single send per request, no list)
# Get your key at: https://app.brevo.com → Settings → SMTP & API → API Keys
# DSGVO note: Open & Click tracking must match the project's privacy policy.
# A check on 2026-06-11 recorded it as disabled. The read-only review on
# 2026-10-12 found nonzero recent open/click aggregates for project mail tags;
# current account settings and anonymization remain unverified.
# See docs/reviews/2026-10-12-code-review.md at the repository root.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Feature-Flag für den automatisierten 3-Tage-Followup nach jeder Brief-Erstellung.
# Nur wenn exakt auf "true" gesetzt, wird via Brevo `scheduledAt` (~72h später)
# eine zweite Mail eingequeut. Erlaubt schnelle Notabschaltung ohne Deploy.
BREVO_FOLLOWUP_ENABLED=

# Salt für den In-Memory Rate-Limiter (lib/rateLimit.ts hashIdentifier).
# DSGVO M7: IP- und E-Mail-Werte werden vor Verwendung als Bucket-Key gehasht,
# damit die rohen Identifier nicht in der Map liegen. Wenn nicht gesetzt, nutzt
# der Limiter einen pro-Prozess-Zufalls-Salt — funktioniert, ist aber bei jedem
# Cold-Start neu (in-memory Buckets sind eh per-instance).
RATE_LIMIT_SALT=

# Optionale interne Empfangsadresse für BCC-Kopien administrativer
# Kampagnenmails. Öffentliche Kontakt- und Reply-To-Links verwenden die feste
# Projektadresse Brief-nach-Berlin@posteo.de.
THOMAS_MAIL=

# --- 999.6 Ebenen-Routing (Bund/Land/Kommune) -------------------------------
# Wave-3-Kill-Switch: nur wenn exakt "true", klassifiziert Mistral das Anliegen
# auf eine Ebene und der Wizard zeigt den Ebene-Auswahl-Step. Bei "false"
# läuft der heutige Bund-only-Flow unverändert.
# Sicherer Rollout: zuerst LETTER_PROMPT_LEVEL_AWARE=true deployen und prüfen,
# erst danach LANDTAG_ROUTING_ENABLED=true setzen und damit die UI freigeben.
# Sicherer Rollback: zuerst LANDTAG_ROUTING_ENABLED=false setzen, erst danach
# LETTER_PROMPT_LEVEL_AWARE=false. So erzeugt eine sichtbare Level-Auswahl nie
# Land-/Kommune-Briefe mit dem Bund-Prompt.
LANDTAG_ROUTING_ENABLED=false

# Wave-4-Kill-Switch (separat von LANDTAG_ROUTING_ENABLED): nur wenn exakt
# "true", bekommt der Brief-Prompt Land-/Kommune-spezifische Blöcke. Bei
# "false" nutzen alle Ebenen den heutigen Bund-Prompt. Deshalb niemals das
# Routing-UI aktivieren, solange dieses Flag false ist.
LETTER_PROMPT_LEVEL_AWARE=false

# HMAC-Secret für den kurzlebigen Routing-Prefetch-Token (15 min TTL).
# Optional: fällt auf FEEDBACK_TOKEN_SECRET zurück, wenn nicht gesetzt.
# Bei Nutzung einkommentieren und füllen; ein leerer Wert verhindert den Fallback.
# ROUTING_TOKEN_SECRET=

# Separate Secrets für freiwillige Themensignale. Der Lookup-HMAC bleibt stabil,
# auch wenn das kurzlebige Token-Secret rotiert. Hash-Secret zufällig setzen;
# es wird auch für die persönliche Datenübersicht und Löschung benötigt.
# Token-Secret ist optional und fällt sonst auf FEEDBACK_TOKEN_SECRET zurück.
# Bei Nutzung einkommentieren und füllen; ein leerer Wert verhindert den Fallback.
# LETTER_SIGNAL_TOKEN_SECRET=
LETTER_SIGNAL_EMAIL_HASH_SECRET=

# One shared password for the internal /stats demo. Keep the route closed when empty.
INTERNAL_STATS_PASSWORD=
