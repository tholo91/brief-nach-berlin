// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`DE render snapshot (before the EN/TR refactor) /eltern page 1`] = `"<link rel="preload" as="image" imageSrcSet="/_next/image?url=%2Fimages%2Fimg-eltern-kuechentisch.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fimg-eltern-kuechentisch.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fimg-eltern-kuechentisch.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fimg-eltern-kuechentisch.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fimg-eltern-kuechentisch.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fimg-eltern-kuechentisch.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fimg-eltern-kuechentisch.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fimg-eltern-kuechentisch.webp&amp;w=3840&amp;q=75 3840w" imageSizes="(max-width: 576px) 100vw, 576px"/><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"WebPage","name":"Unterrichtsausfall beschweren: Brief an die Landespolitik","description":"Unterrichtsausfall, Lehrermangel, marode Schule? Als Elternteil an Landtag oder Schulträger schreiben: Anliegen schildern, Entwurf bekommen, eigenen Brief schreiben.","url":"https://www.brief-nach-berlin.de/eltern","inLanguage":"de-DE","isPartOf":{"@id":"https://www.brief-nach-berlin.de/#website"},"publisher":{"@id":"https://www.brief-nach-berlin.de/#organization"}},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Wo kann ich mich über Unterrichtsausfall beschweren?","acceptedAnswer":{"@type":"Answer","text":"Zuerst bei der Schulleitung und der Elternvertretung deiner Schule. Für Lehrkräfte und Unterrichtsausfall ist das Land zuständig, also kannst du auch an Landtagsabgeordnete oder die Landesregierung schreiben. Brief-nach-Berlin hilft dir, daraus einen Briefentwurf an die zuständige Ebene zu machen."}},{"@type":"Question","name":"Wer ist für das Schulgebäude zuständig?","acceptedAnswer":{"@type":"Answer","text":"Für Gebäude, Ausstattung und Schulbus ist in der Regel der Schulträger zuständig, also die Stadt, die Gemeinde oder der Kreis. Lehrkräfte und Lehrpläne gehören zum Land. Die Aufteilung unterscheidet sich je nach Bundesland, die Quelle ist das Niedersächsische Kultusministerium."}},{"@type":"Question","name":"Kann ich an das Kultusministerium schreiben?","acceptedAnswer":{"@type":"Answer","text":"Brief-nach-Berlin schlägt für die Landesebene Landtagsabgeordnete und die Landesregierung vor, in Stadtstaaten den Senat. Das Kultusministerium selbst ist kein eigener Empfänger in der Auswahl. Du kannst es im Brief aber nennen und schildern, was in deinem Bundesland geändert werden soll."}},{"@type":"Question","name":"Ist das für mein Kind sicher?","acceptedAnswer":{"@type":"Answer","text":"Ja. Dein Kind gibt in der Schule Postleitzahl und Anliegen ein, nur während der Verarbeitung, ohne Account. Die Lehrkraft entscheidet, ob der Entwurf als PDF auf dem Gerät bleibt oder per E-Mail kommt; nur beim E-Mail-Weg wird eine Adresse abgefragt. Im Jugendmodus gibt es keine Erinnerungen, keine Spendenbitte und keine Frage nach einer Partei. Trägt die Lehrkraft im Klassenlink den Namen der Schule ein, kommt er in den Brief und wird in keiner Datenbank gespeichert. Den Entwurf formuliert eine KI von Mistral aus Frankreich."}},{"@type":"Question","name":"Was kostet das?","acceptedAnswer":{"@type":"Answer","text":"Nichts. Brief-nach-Berlin ist kostenlos und du brauchst keinen Account. Für den Brief brauchst du nur Papier, einen Umschlag und eine Briefmarke."}}]}]}</script><div class="mx-auto w-full max-w-xl px-5 pb-16 pt-4 sm:pt-10"><img alt="Ein Elternteil schreibt am Küchentisch einen Brief, das Kind zeigt auf eine Zeile, gemalte Illustration" width="1200" height="510" decoding="async" data-nimg="1" class="mb-4 h-24 w-full rounded-xl object-cover object-[center_50%] shadow-md shadow-waldgruen/10 sm:mb-6 sm:h-auto" style="color:transparent" sizes="(max-width: 576px) 100vw, 576px" srcSet="/_next/image?url=%2Fimages%2Fimg-eltern-kuechentisch.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fimg-eltern-kuechentisch.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fimg-eltern-kuechentisch.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fimg-eltern-kuechentisch.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fimg-eltern-kuechentisch.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fimg-eltern-kuechentisch.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fimg-eltern-kuechentisch.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fimg-eltern-kuechentisch.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fimages%2Fimg-eltern-kuechentisch.webp&amp;w=3840&amp;q=75"/><h1 class="font-typewriter text-2xl font-bold leading-tight tracking-tight text-waldgruen-dark text-balance sm:text-[2rem]">Schreib der Politik, was an der Schule deiner Kinder fehlt.</h1><p class="mt-2 font-body text-base leading-relaxed text-warmgrau sm:mt-4 sm:text-lg">Unterrichtsausfall, gesperrte Turnhalle, verspäteter Schulbus? Ich suche die zuständige Ebene und schreibe dir einen Entwurf als Vorlage für deinen Brief.</p><div class="mt-6 grid gap-3 sm:grid-cols-2"><a href="#schreiben" class="flex items-start justify-between gap-3 rounded-xl border border-waldgruen/20 bg-white p-4 transition-colors hover:border-waldgruen/45 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-waldgruen focus-visible:ring-offset-2"><span><span class="block font-body text-base font-bold text-waldgruen-dark">Ich will selbst einen Brief schreiben</span><span class="mt-1 block font-body text-sm text-warmgrau/80">Anliegen schildern, Entwurf bekommen, den Brief von Hand schreiben.</span></span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-1 shrink-0 rotate-90 text-waldgruen"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg></a><a href="#sicher" class="flex items-start justify-between gap-3 rounded-xl border border-waldgruen/20 bg-white p-4 transition-colors hover:border-waldgruen/45 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-waldgruen focus-visible:ring-offset-2"><span><span class="block font-body text-base font-bold text-waldgruen-dark">Mein Kind will Brief-nach-Berlin mit seiner Klasse nutzen</span><span class="mt-1 block font-body text-sm text-warmgrau/80">Was mit den Daten passiert und wie die Lehrkraft startet.</span></span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-1 shrink-0 rotate-90 text-waldgruen"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg></a></div><div id="schreiben" class="mt-8 scroll-mt-32"><div class="overflow-hidden rounded-sm border border-warmgrau/15 bg-white shadow-[0_20px_50px_-30px_rgba(27,67,50,0.45)]"><div aria-hidden="true" class="h-2 w-full" style="background:repeating-linear-gradient(-45deg, #c1121f 0 10px, #faf8f5 10px 15px, #1d3557 15px 25px, #faf8f5 25px 30px)"></div><div class="space-y-8 p-5 sm:p-7"><div><label for="eltern-klasse" class="font-typewriter text-base font-bold text-waldgruen-dark sm:text-lg">Klasse deines Kindes <span class="font-body text-sm font-normal text-warmgrau/70">(optional)</span></label><select id="eltern-klasse" class="mt-3 block min-h-11 w-full rounded-lg border border-waldgruen/25 bg-white px-3 font-body text-base text-warmgrau outline-none transition focus:border-waldgruen focus:ring-2 focus:ring-waldgruen/20 sm:w-56"><option value="" selected="">Keine Angabe</option><option value="1">1. Klasse</option><option value="2">2. Klasse</option><option value="3">3. Klasse</option><option value="4">4. Klasse</option><option value="5">5. Klasse</option><option value="6">6. Klasse</option><option value="7">7. Klasse</option><option value="8">8. Klasse</option><option value="9">9. Klasse</option><option value="10">10. Klasse</option><option value="11">11. Klasse</option><option value="12">12. Klasse</option><option value="13">13. Klasse</option></select></div><section aria-labelledby="eltern-thema-heading"><div class="flex items-baseline justify-between gap-2"><h2 id="eltern-thema-heading" class="font-typewriter text-base font-bold text-waldgruen-dark sm:text-lg">Worum geht es dir?</h2><button type="button" aria-expanded="false" aria-controls="eltern-thema-chips" class="-my-2.5 inline-flex min-h-11 shrink-0 items-center gap-1 rounded-lg pl-2 pr-1 font-body text-sm font-semibold text-waldgruen hover:text-waldgruen-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-waldgruen focus-visible:ring-offset-2 [&amp;[aria-expanded=true]_svg]:rotate-180">Alle Themen<svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="shrink-0 text-waldgruen transition-transform duration-200" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></button></div><p class="mt-1 font-body text-sm leading-relaxed text-warmgrau/70">Wähl bis zu zwei Themen. Jedes fügt einen Satzanfang ein, den du selbst zu Ende schreibst.</p><div id="eltern-thema-chips" class="chip-scroll-fade scrollbar-hide -mx-1 mt-2 grid auto-cols-max grid-flow-col grid-rows-2 snap-x gap-2 overflow-x-auto py-1 pl-1 pr-10 sm:mt-3"><button type="button" aria-pressed="false" class="group flex items-center gap-2 rounded-lg border font-body h-11 shrink-0 snap-start whitespace-nowrap px-3.5 text-[0.95rem] font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-waldgruen focus-visible:ring-offset-2 border-waldgruen/25 bg-surface text-warmgrau hover:border-waldgruen/50 hover:bg-waldgruen/5"><span aria-hidden="true" class="relative h-5 w-5 shrink-0"><span class="absolute inset-0 flex items-center justify-center text-base leading-none transition-opacity duration-150 group-hover:opacity-0 group-focus-visible:opacity-0">⏰</span><span class="absolute inset-0 flex items-center justify-center rounded-full border text-xs font-bold transition-opacity duration-150 border-waldgruen/40 bg-surface text-waldgruen opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100">+</span></span><span>Unterrichts­ausfall</span></button><button type="button" aria-pressed="false" class="group flex items-center gap-2 rounded-lg border font-body h-11 shrink-0 snap-start whitespace-nowrap px-3.5 text-[0.95rem] font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-waldgruen focus-visible:ring-offset-2 border-waldgruen/25 bg-surface text-warmgrau hover:border-waldgruen/50 hover:bg-waldgruen/5"><span aria-hidden="true" class="relative h-5 w-5 shrink-0"><span class="absolute inset-0 flex items-center justify-center text-base leading-none transition-opacity duration-150 group-hover:opacity-0 group-focus-visible:opacity-0">📚</span><span class="absolute inset-0 flex items-center justify-center rounded-full border text-xs font-bold transition-opacity duration-150 border-waldgruen/40 bg-surface text-waldgruen opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100">+</span></span><span>Lehrkräfte­mangel</span></button><button type="button" aria-pressed="false" class="group flex items-center gap-2 rounded-lg border font-body h-11 shrink-0 snap-start whitespace-nowrap px-3.5 text-[0.95rem] font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-waldgruen focus-visible:ring-offset-2 border-waldgruen/25 bg-surface text-warmgrau hover:border-waldgruen/50 hover:bg-waldgruen/5"><span aria-hidden="true" class="relative h-5 w-5 shrink-0"><span class="absolute inset-0 flex items-center justify-center text-base leading-none transition-opacity duration-150 group-hover:opacity-0 group-focus-visible:opacity-0">🏫</span><span class="absolute inset-0 flex items-center justify-center rounded-full border text-xs font-bold transition-opacity duration-150 border-waldgruen/40 bg-surface text-waldgruen opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100">+</span></span><span>Schul­gebäude &amp; Ausstattung</span></button><button type="button" aria-pressed="false" class="group flex items-center gap-2 rounded-lg border font-body h-11 shrink-0 snap-start whitespace-nowrap px-3.5 text-[0.95rem] font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-waldgruen focus-visible:ring-offset-2 border-waldgruen/25 bg-surface text-warmgrau hover:border-waldgruen/50 hover:bg-waldgruen/5"><span aria-hidden="true" class="relative h-5 w-5 shrink-0"><span class="absolute inset-0 flex items-center justify-center text-base leading-none transition-opacity duration-150 group-hover:opacity-0 group-focus-visible:opacity-0">🍽️</span><span class="absolute inset-0 flex items-center justify-center rounded-full border text-xs font-bold transition-opacity duration-150 border-waldgruen/40 bg-surface text-waldgruen opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100">+</span></span><span>Ganztag &amp; Betreuung</span></button><button type="button" aria-pressed="false" class="group flex items-center gap-2 rounded-lg border font-body h-11 shrink-0 snap-start whitespace-nowrap px-3.5 text-[0.95rem] font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-waldgruen focus-visible:ring-offset-2 border-waldgruen/25 bg-surface text-warmgrau hover:border-waldgruen/50 hover:bg-waldgruen/5"><span aria-hidden="true" class="relative h-5 w-5 shrink-0"><span class="absolute inset-0 flex items-center justify-center text-base leading-none transition-opacity duration-150 group-hover:opacity-0 group-focus-visible:opacity-0">🤝</span><span class="absolute inset-0 flex items-center justify-center rounded-full border text-xs font-bold transition-opacity duration-150 border-waldgruen/40 bg-surface text-waldgruen opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100">+</span></span><span>Inklusion &amp; Förderung</span></button><button type="button" aria-pressed="false" class="group flex items-center gap-2 rounded-lg border font-body h-11 shrink-0 snap-start whitespace-nowrap px-3.5 text-[0.95rem] font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-waldgruen focus-visible:ring-offset-2 border-waldgruen/25 bg-surface text-warmgrau hover:border-waldgruen/50 hover:bg-waldgruen/5"><span aria-hidden="true" class="relative h-5 w-5 shrink-0"><span class="absolute inset-0 flex items-center justify-center text-base leading-none transition-opacity duration-150 group-hover:opacity-0 group-focus-visible:opacity-0">🚌</span><span class="absolute inset-0 flex items-center justify-center rounded-full border text-xs font-bold transition-opacity duration-150 border-waldgruen/40 bg-surface text-waldgruen opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100">+</span></span><span>Schulweg &amp; Bus</span></button><button type="button" aria-pressed="false" class="group flex items-center gap-2 rounded-lg border font-body h-11 shrink-0 snap-start whitespace-nowrap px-3.5 text-[0.95rem] font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-waldgruen focus-visible:ring-offset-2 border-waldgruen/25 bg-surface text-warmgrau hover:border-waldgruen/50 hover:bg-waldgruen/5"><span aria-hidden="true" class="relative h-5 w-5 shrink-0"><span class="absolute inset-0 flex items-center justify-center text-base leading-none transition-opacity duration-150 group-hover:opacity-0 group-focus-visible:opacity-0">💻</span><span class="absolute inset-0 flex items-center justify-center rounded-full border text-xs font-bold transition-opacity duration-150 border-waldgruen/40 bg-surface text-waldgruen opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100">+</span></span><span>Digitales</span></button></div></section><section aria-labelledby="eltern-text-label"><h2 class="font-typewriter text-base font-bold text-waldgruen-dark sm:text-lg"><label id="eltern-text-label" for="eltern-issue-text">Was ist passiert?</label></h2><p id="eltern-text-help" class="mt-1 font-body text-sm leading-relaxed text-warmgrau/70">Je konkreter, desto besser: Was, wo, seit wann. Du kannst auch sprechen statt tippen.</p><div class="relative mt-3"><textarea id="eltern-issue-text" maxLength="5000" rows="7" aria-describedby="eltern-text-help eltern-status" placeholder="Zum Beispiel: Seit den Herbstferien fällt in der Klasse meines Kindes Mathe fast jede Woche aus." class="min-h-44 w-full resize-y rounded-lg border border-dashed border-waldgruen/30 bg-white py-3 pl-4 pr-14 font-body text-base leading-relaxed text-warmgrau outline-none transition placeholder:text-warmgrau/40 focus:border-waldgruen focus:ring-2 focus:ring-waldgruen/20"></textarea></div></section><div><p id="eltern-status" aria-live="polite" class="min-h-5 font-body text-sm font-semibold text-waldgruen-dark"></p><button type="button" class="mt-2 inline-flex min-h-12 w-full items-center justify-center gap-3 rounded-lg bg-waldgruen px-6 py-3 font-body text-base font-bold text-creme transition-colors hover:bg-waldgruen-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-waldgruen focus-visible:ring-offset-2">Brief entwerfen<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg></button><p class="mt-3 font-body text-sm leading-relaxed text-warmgrau/70">Als Nächstes gibst du deine E-Mail-Adresse und Postleitzahl an und wählst, an wen der Brief geht.</p></div></div></div></div><section aria-labelledby="eltern-zustaendig" class="reveal mt-14"><h2 id="eltern-zustaendig" class="font-typewriter text-xl font-bold text-waldgruen-dark sm:text-2xl">Wer ist zuständig?</h2><div class="mt-5 -rotate-1 border border-warmgrau/20 bg-creme p-5 shadow-[3px_4px_0_rgba(107,100,92,0.15)] motion-reduce:rotate-0 sm:p-6"><div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8"><div><h3 class="font-typewriter text-xl font-bold text-waldgruen">Land</h3><p class="font-body text-base leading-relaxed text-warmgrau mt-1">Lehrkräfte, Unterrichtsausfall, Lehrpläne, Schulgesetz.</p><p class="mt-2 font-body text-sm font-semibold text-waldgruen-dark">Landtag und Landesregierung</p></div><div class="border-t border-dashed border-warmgrau/30 pt-6 sm:border-l sm:border-t-0 sm:pl-8 sm:pt-0"><h3 class="font-typewriter text-xl font-bold text-airmail-blau">Schulträger</h3><p class="font-body text-base leading-relaxed text-warmgrau mt-1">Gebäude, Ausstattung, Schulbus.</p><p class="mt-2 font-body text-sm font-semibold text-waldgruen-dark">Stadt, Gemeinde oder Kreis</p></div></div></div><p class="font-body text-base leading-relaxed text-warmgrau mt-4">Brief-nach-Berlin schlägt dir die zuständige Ebene vor. Prüf den Vorschlag, bevor du deinen Brief schreibst. Die Aufteilung unterscheidet sich je nach Bundesland, sie stammt vom Niedersächsischen Kultusministerium.</p></section><section id="sicher" aria-labelledby="eltern-daten" class="reveal mt-14 scroll-mt-32"><h2 id="eltern-daten" class="font-typewriter text-xl font-bold text-waldgruen-dark sm:text-2xl">Ist das sicher?</h2><ul class="mt-4 list-disc space-y-3 pl-5 marker:text-waldgruen"><li class="font-body text-base leading-relaxed text-warmgrau">Verarbeitet werden Postleitzahl und Anliegen als Text, nur während der Verarbeitung, beim E-Mail-Weg auch die E-Mail-Adresse. Es gibt keine Accounts, auf meinem Server wird dafür nichts gespeichert. Trägt die Lehrkraft den Schulnamen ein, kommt er in den Brief und wird ebenfalls in keiner Datenbank gespeichert.</li><li class="font-body text-base leading-relaxed text-warmgrau">Den Entwurf formuliert eine KI von Mistral, einem Unternehmen aus Frankreich.</li><li class="font-body text-base leading-relaxed text-warmgrau">Im Jugendmodus bekommt dein Kind höchstens die eine Mail mit dem Entwurf: keine Erinnerungen, keine Spendenbitte, keine Frage nach einer Partei, keine Kartenfunktion.</li></ul><p class="font-body text-base leading-relaxed text-warmgrau mt-4">Alle Details stehen in der <a href="/datenschutz#jugendmodus">Datenschutzerklärung</a> und auf der Seite <a href="/unterricht">für Schulen</a>.</p></section><section aria-labelledby="eltern-faq" class="reveal mt-14"><h2 id="eltern-faq" class="font-typewriter text-xl font-bold text-waldgruen-dark sm:text-2xl mb-4">Häufige Fragen</h2><div class="divide-y divide-waldgruen/15 border-y border-waldgruen/15 not-prose"><details class="group [&amp;[open]_svg]:rotate-180 [&amp;[open]]:bg-waldgruen/[0.03] rounded-lg transition-colors duration-150 -mx-3 px-3"><summary class="flex items-center justify-between gap-4 py-3.5 md:py-5 cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="font-body text-[0.95rem] leading-snug md:text-lg font-semibold text-waldgruen-dark pr-2 transition-colors duration-150 group-open:text-waldgruen">Wo kann ich mich über Unterrichtsausfall beschweren?</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="shrink-0 text-waldgruen transition-transform duration-200" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></summary><p class="font-body text-base text-warmgrau leading-relaxed pb-4 pr-2 md:pb-6 md:pr-8">Zuerst bei der Schulleitung und der Elternvertretung deiner Schule. Für Lehrkräfte und Unterrichtsausfall ist das Land zuständig, also kannst du auch an Landtagsabgeordnete oder die Landesregierung schreiben. Brief-nach-Berlin hilft dir, daraus einen Briefentwurf an die zuständige Ebene zu machen.</p></details><details class="group [&amp;[open]_svg]:rotate-180 [&amp;[open]]:bg-waldgruen/[0.03] rounded-lg transition-colors duration-150 -mx-3 px-3"><summary class="flex items-center justify-between gap-4 py-3.5 md:py-5 cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="font-body text-[0.95rem] leading-snug md:text-lg font-semibold text-waldgruen-dark pr-2 transition-colors duration-150 group-open:text-waldgruen">Wer ist für das Schulgebäude zuständig?</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="shrink-0 text-waldgruen transition-transform duration-200" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></summary><p class="font-body text-base text-warmgrau leading-relaxed pb-4 pr-2 md:pb-6 md:pr-8">Für Gebäude, Ausstattung und Schulbus ist in der Regel der Schulträger zuständig, also die Stadt, die Gemeinde oder der Kreis. Lehrkräfte und Lehrpläne gehören zum Land. Die Aufteilung unterscheidet sich je nach Bundesland, die Quelle ist das Niedersächsische Kultusministerium.</p></details><details class="group [&amp;[open]_svg]:rotate-180 [&amp;[open]]:bg-waldgruen/[0.03] rounded-lg transition-colors duration-150 -mx-3 px-3"><summary class="flex items-center justify-between gap-4 py-3.5 md:py-5 cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="font-body text-[0.95rem] leading-snug md:text-lg font-semibold text-waldgruen-dark pr-2 transition-colors duration-150 group-open:text-waldgruen">Kann ich an das Kultusministerium schreiben?</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="shrink-0 text-waldgruen transition-transform duration-200" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></summary><p class="font-body text-base text-warmgrau leading-relaxed pb-4 pr-2 md:pb-6 md:pr-8">Brief-nach-Berlin schlägt für die Landesebene Landtagsabgeordnete und die Landesregierung vor, in Stadtstaaten den Senat. Das Kultusministerium selbst ist kein eigener Empfänger in der Auswahl. Du kannst es im Brief aber nennen und schildern, was in deinem Bundesland geändert werden soll.</p></details><details class="group [&amp;[open]_svg]:rotate-180 [&amp;[open]]:bg-waldgruen/[0.03] rounded-lg transition-colors duration-150 -mx-3 px-3"><summary class="flex items-center justify-between gap-4 py-3.5 md:py-5 cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="font-body text-[0.95rem] leading-snug md:text-lg font-semibold text-waldgruen-dark pr-2 transition-colors duration-150 group-open:text-waldgruen">Ist das für mein Kind sicher?</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="shrink-0 text-waldgruen transition-transform duration-200" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></summary><p class="font-body text-base text-warmgrau leading-relaxed pb-4 pr-2 md:pb-6 md:pr-8">Ja. Dein Kind gibt in der Schule Postleitzahl und Anliegen ein, nur während der Verarbeitung, ohne Account. Die Lehrkraft entscheidet, ob der Entwurf als PDF auf dem Gerät bleibt oder per E-Mail kommt; nur beim E-Mail-Weg wird eine Adresse abgefragt. Im Jugendmodus gibt es keine Erinnerungen, keine Spendenbitte und keine Frage nach einer Partei. Trägt die Lehrkraft im Klassenlink den Namen der Schule ein, kommt er in den Brief und wird in keiner Datenbank gespeichert. Den Entwurf formuliert eine KI von Mistral aus Frankreich.</p></details><details class="group [&amp;[open]_svg]:rotate-180 [&amp;[open]]:bg-waldgruen/[0.03] rounded-lg transition-colors duration-150 -mx-3 px-3"><summary class="flex items-center justify-between gap-4 py-3.5 md:py-5 cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="font-body text-[0.95rem] leading-snug md:text-lg font-semibold text-waldgruen-dark pr-2 transition-colors duration-150 group-open:text-waldgruen">Was kostet das?</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="shrink-0 text-waldgruen transition-transform duration-200" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></summary><p class="font-body text-base text-warmgrau leading-relaxed pb-4 pr-2 md:pb-6 md:pr-8">Nichts. Brief-nach-Berlin ist kostenlos und du brauchst keinen Account. Für den Brief brauchst du nur Papier, einen Umschlag und eine Briefmarke.</p></details></div></section></div>"`;

