exports[`DE render snapshot (before the EN/TR refactor) Step1Form class link, PDF mode 1`] = `"<form noValidate=""><h1 class="font-typewriter text-[28px] font-semibold leading-[1.2] text-waldgruen-dark mb-2">Wohin soll deine Kopie gehen?</h1><p class="font-body text-sm text-warmgrau/70 mb-8">Deine Lehrkraft hat die Postleitzahl schon eingetragen. An deine E-Mail-Adresse schicke ich dir den Entwurf und die Anschrift.</p><div class="space-y-4"><div><input type="hidden" name="plz"/><p id="plz-hint" class="font-body text-sm font-semibold text-warmgrau" aria-live="polite">PLZ 28195 (von deiner Lehrkraft)</p></div></div><div class="mt-8"><button type="submit" disabled="" class="relative bg-waldgruen text-creme font-semibold text-base px-8 pr-14 py-4 rounded-xl whitespace-nowrap transition-colors min-h-[44px] w-full opacity-50 cursor-not-allowed">Weiter<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="absolute right-5 top-1/2 -translate-y-1/2"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg></button></div></form>"`;

exports[`DE render snapshot (before the EN/TR refactor) Step1Form class link, email mode 1`] = `"<form noValidate=""><h1 class="font-typewriter text-[28px] font-semibold leading-[1.2] text-waldgruen-dark mb-2">Wohin soll deine Kopie gehen?</h1><p class="font-body text-sm text-warmgrau/70 mb-8">Deine Lehrkraft hat die Postleitzahl schon eingetragen. An deine E-Mail-Adresse schicke ich dir den Entwurf und die Anschrift.</p><div class="space-y-4"><div><input type="hidden" name="plz"/><p id="plz-hint" class="font-body text-sm font-semibold text-warmgrau" aria-live="polite">PLZ 28195 (von deiner Lehrkraft)</p></div><div><label for="email" class="block font-body text-sm font-semibold text-warmgrau mb-1">E-Mail-Adresse *</label><input id="email" type="email" placeholder="deine@email.de" class="bg-creme border rounded-lg px-4 py-3 text-base font-body text-warmgrau focus:outline-none focus:ring-2 focus:ring-waldgruen focus:border-waldgruen w-full border-warmgrau/30" aria-describedby="email-hint" aria-invalid="false" name="email"/><p id="email-hint" class="text-sm text-warmgrau/60 mt-1">An diese Adresse schicke ich dir eine Kopie deines Entwurfs, mit der Anschrift für den Umschlag.</p></div></div><div class="mt-8"><button type="submit" disabled="" class="relative bg-waldgruen text-creme font-semibold text-base px-8 pr-14 py-4 rounded-xl whitespace-nowrap transition-colors min-h-[44px] w-full opacity-50 cursor-not-allowed">Weiter<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="absolute right-5 top-1/2 -translate-y-1/2"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg></button></div></form>"`;

exports[`DE render snapshot (before the EN/TR refactor) Step3Success youth with school recipient 1`] = `
"<div class="grid gap-x-8 gap-y-7 md:grid-cols-[minmax(0,1.05fr)_minmax(18rem,0.95fr)] lg:grid-cols-[minmax(0,1.08fr)_minmax(20rem,0.92fr)] lg:gap-x-12"><section class="min-w-0 md:col-start-1 md:row-start-1"><div class="mb-3 flex items-center gap-3"><svg width="44" height="44" viewBox="0 0 48 48" fill="none" class="text-waldgruen flex-shrink-0" aria-hidden="true"><rect x="4" y="10" width="40" height="28" rx="3" stroke="currentColor" stroke-width="2.5" fill="none"></rect><path d="M4 13 L24 28 L44 13" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linejoin="round"></path></svg><h1 class="font-typewriter text-[28px] font-semibold leading-[1.2] text-waldgruen-dark m-0">Dein Brief ist fertig</h1></div><p class="font-body text-base text-warmgrau leading-relaxed mt-3">Dein Entwurf steht unten. Eine Kopie kommt an <strong>sc•••••@example.org</strong>.</p><div class="mt-5 rounded-lg border-2 border-waldgruen bg-waldgruen/10 p-4"><p class="font-body text-base font-semibold text-warmgrau">Dein Brief geht an Maria Muster (SPD)</p><p class="mt-3 font-body text-sm font-semibold text-waldgruen-dark">Warum diese Person?</p><p class="mt-0.5 font-body text-sm leading-relaxed text-warmgrau/80">Die Bundespolitik entscheidet hier mit.</p></div><div class="block"><section aria-labelledby="youth-draft-heading" class="mt-6"><h2 id="youth-draft-heading" class="font-typewriter text-xl font-bold text-waldgruen-dark m-0">Dein Entwurf</h2><p class="mt-1 font-body text-sm leading-relaxed text-warmgrau">Schreib deinen Brief von Hand, der Entwurf hilft dir dabei. Du kannst ihn hier direkt ändern und ein eigenes Erlebnis ergänzen. Eine Kopie kommt per Mail.</p><div class="theme-day overflow-hidden rounded-sm border border-warmgrau/15 bg-white shadow-[0_20px_50px_-30px_rgba(27,67,50,0.45)] mt-3"><div aria-hidden="true" class="h-2 w-full" style="background:repeating-linear-gradient(-45deg, #c1121f 0 10px, #faf8f5 10px 15px, #1d3557 15px 25px, #faf8f5 25px 30px)"></div><label for="_R_3h_" class="sr-only">Dein Brief, du kannst ihn bearbeiten</label><textarea id="_R_3h_" rows="10" spellCheck="true" class="block w-full max-w-prose resize-y border-0 bg-transparent p-5 text-left font-body text-[17px] leading-[1.75] text-warmgrau outline-none focus-visible:bg-bernstein/5 sm:p-7" style="field-sizing:content">Sehr geehrte Frau Muster,

an unserer Schule fällt viel Unterricht aus.

Mit freundlichen Grüßen</textarea></div><div class="mt-3 flex flex-wrap items-center gap-3"><button type="button" class="rounded-lg border border-waldgruen/30 bg-white px-4 py-2 font-body text-sm font-semibold text-waldgruen-dark transition-colors hover:bg-waldgruen/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-waldgruen"><span aria-live="polite">Text kopieren</span></button><span class="font-body text-sm text-warmgrau/80">Tipp ins Blatt, um etwas zu ändern.</span></div><aside class="mt-6 rounded-xl border border-waldgruen/20 bg-waldgruen/5 p-4"><h3 class="m-0 font-body text-base font-semibold text-waldgruen-dark">So wirkt dein Brief</h3><ul class="mt-2 mb-0 list-disc space-y-1 pl-5 font-body text-sm leading-relaxed text-warmgrau"><li>Kurz und klar: ein, höchstens zwei Anliegen.</li><li>Gut begründet: Warum ist es wichtig, und was soll sich ändern?</li><li>Persönlich: Schreib, was das Thema mit dir zu tun hat.</li></ul></aside><div class="mt-4 rounded-xl border border-warmgrau/25 bg-creme/70 p-4"><h3 class="m-0 font-body text-base font-semibold text-waldgruen-dark">Brief verbessern lassen</h3><p class="mt-1 font-body text-sm leading-relaxed text-warmgrau">Sag, was anders werden soll und warum. Das geht einmal, danach siehst du beide Fassungen.</p><label for="_R_3hH1_" class="mt-3 block font-body text-sm font-semibold text-waldgruen-dark">Was soll anders werden und warum?</label><div class="mt-2 flex flex-wrap gap-2"><button type="button" class="rounded-full border border-waldgruen/30 bg-white px-3 py-1 font-body text-sm text-waldgruen-dark transition-colors hover:bg-waldgruen/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-waldgruen">Kürzer</button><button type="button" class="rounded-full border border-waldgruen/30 bg-white px-3 py-1 font-body text-sm text-waldgruen-dark transition-colors hover:bg-waldgruen/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-waldgruen">Einfachere Wörter</button><button type="button" class="rounded-full border border-waldgruen/30 bg-white px-3 py-1 font-body text-sm text-waldgruen-dark transition-colors hover:bg-waldgruen/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-waldgruen">Klingt mehr nach mir</button><button type="button" class="rounded-full border border-waldgruen/30 bg-white px-3 py-1 font-body text-sm text-waldgruen-dark transition-colors hover:bg-waldgruen/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-waldgruen">Höflicher</button></div><textarea id="_R_3hH1_" maxLength="1000" rows="3" placeholder="Zum Beispiel: Der Brief klingt zu erwachsen. Er soll einfacher und mehr nach mir klingen." class="mt-2 block w-full rounded-lg border border-warmgrau/30 bg-white p-3 font-body text-base leading-relaxed text-warmgrau focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-waldgruen"></textarea><button type="button" aria-busy="false" class="mt-3 inline-flex min-h-12 w-full items-center justify-center rounded-lg bg-waldgruen px-4 py-2.5 font-body text-base font-bold text-creme transition-colors hover:bg-waldgruen-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-waldgruen focus-visible:ring-offset-2 disabled:cursor-wait disabled:opacity-70 sm:w-auto">Brief verbessern</button></div><div class="mt-4 rounded-xl border border-warmgrau/25 bg-creme/70 p-4"><h3 class="m-0 font-body text-sm font-semibold text-waldgruen-dark">Für den Umschlag</h3><address class="mt-1 font-body text-base not-italic leading-relaxed text-warmgrau"><span class="block">Maria Muster, MdB</span><span class="block">Deutscher Bundestag</span><span class="block">Platz der Republik 1</span><span class="block">11011 Berlin</span></address></div></section><div class="mt-3 flex items-center justify-center divide-x divide-warmgrau/20"><button type="button" aria-expanded="false" class="cursor-pointer px-3 font-body text-sm text-warmgrau/55 underline underline-offset-2 transition-colors hover:text-warmgrau/75">Keine E-Mail erhalten?</button><button type="button" aria-expanded="false" class="inline-flex cursor-pointer items-center gap-1.5 px-3 font-body text-sm text-warmgrau/55 transition-colors hover:text-warmgrau/75"><span class="underline underline-offset-2">So geht es weiter</span><span aria-hidden="true" class="text-[9px] transition-transform duration-300 ">▾</span></button></div></div><div><div class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden "><div class="mb-4 border-l-2 border-waldgruen/35 pl-4"><p class="font-body text-sm font-semibold text-waldgruen-dark">Mach diesen Brief zu deinem Brief.</p><p class="mt-1 font-body text-sm leading-relaxed text-warmgrau/75">Lies dir den Entwurf durch und pass Ton, Formulierungen oder einzelne Argumente so an, dass der Brief sich nach dir anfühlt. Der Entwurf ist ein Anfang, die Unterschrift ist deine.</p></div><ol class="space-y-3 pt-1"><li class="flex gap-3"><span class="flex-shrink-0 w-6 h-6 rounded-full bg-waldgruen/15 text-waldgruen font-body text-xs font-bold flex items-center justify-center mt-0.5">1</span><p class="font-body text-sm text-warmgrau leading-relaxed"><strong>Brief schreiben.</strong> Schreib deinen Brief von Hand, der Entwurf hilft dir dabei, und bleib bei deinem Schreibstil. Handgeschriebene Briefe werden im Bundestag tatsächlich gelesen und besprochen.</p></li><li class="flex gap-3"><span class="flex-shrink-0 w-6 h-6 rounded-full bg-waldgruen/15 text-waldgruen font-body text-xs font-bold flex items-center justify-center mt-0.5">2</span><p class="font-body text-sm text-warmgrau leading-relaxed"><strong>Adresse aufschreiben, Briefmarke drauf, ab zur Post.</strong> Die Anschrift steht unter deinem Entwurf.</p></li><li class="flex gap-3"><span class="flex-shrink-0 w-6 h-6 rounded-full bg-waldgruen/15 text-waldgruen font-body text-xs font-bold flex items-center justify-center mt-0.5">3</span><p class="font-body text-sm text-warmgrau leading-relaxed"><strong>Weitersagen.</strong> Je mehr Menschen schreiben, desto mehr Gewicht hat jeder einzelne Brief.</p></li></ol></div></div></div></section><aside class="min-w-0 border-t border-warmgrau/15 pt-6 md:-mt-1 md:col-start-2 md:row-span-2 md:row-start-1 md:border-l md:border-t-0 md:pl-8 md:pt-12"></aside></div>"
`;

exports[`DE render snapshot (before the EN/TR refactor) Step3Success youth, PDF mode 1`] = `
"<div class="grid gap-x-8 gap-y-7 md:grid-cols-[minmax(0,1.05fr)_minmax(18rem,0.95fr)] lg:grid-cols-[minmax(0,1.08fr)_minmax(20rem,0.92fr)] lg:gap-x-12"><section class="min-w-0 md:col-start-1 md:row-start-1"><div class="mb-3 flex items-center gap-3"><svg width="44" height="44" viewBox="0 0 48 48" fill="none" class="text-waldgruen flex-shrink-0" aria-hidden="true"><rect x="4" y="10" width="40" height="28" rx="3" stroke="currentColor" stroke-width="2.5" fill="none"></rect><path d="M4 13 L24 28 L44 13" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linejoin="round"></path></svg><h1 class="font-typewriter text-[28px] font-semibold leading-[1.2] text-waldgruen-dark m-0">Dein Brief ist fertig</h1></div><p class="font-body text-base text-warmgrau leading-relaxed mt-3">Dein Entwurf steht unten. Speicher ihn als PDF, bevor du die Seite schließt.</p><div class="block"><section aria-labelledby="youth-draft-heading" class="mt-6"><h2 id="youth-draft-heading" class="font-typewriter text-xl font-bold text-waldgruen-dark m-0">Dein Entwurf</h2><p class="mt-1 font-body text-sm leading-relaxed text-warmgrau">Schreib deinen Brief von Hand, der Entwurf hilft dir dabei. Du kannst ihn hier direkt ändern und ein eigenes Erlebnis ergänzen.</p><div class="theme-day overflow-hidden rounded-sm border border-warmgrau/15 bg-white shadow-[0_20px_50px_-30px_rgba(27,67,50,0.45)] mt-3"><div aria-hidden="true" class="h-2 w-full" style="background:repeating-linear-gradient(-45deg, #c1121f 0 10px, #faf8f5 10px 15px, #1d3557 15px 25px, #faf8f5 25px 30px)"></div><label for="_R_3h_" class="sr-only">Dein Brief, du kannst ihn bearbeiten</label><textarea id="_R_3h_" rows="10" spellCheck="true" class="block w-full max-w-prose resize-y border-0 bg-transparent p-5 text-left font-body text-[17px] leading-[1.75] text-warmgrau outline-none focus-visible:bg-bernstein/5 sm:p-7" style="field-sizing:content">Sehr geehrte Frau Muster,

an unserer Schule fällt viel Unterricht aus.

Mit freundlichen Grüßen</textarea></div><div class="mt-3 flex flex-wrap items-center gap-3"><button type="button" class="rounded-lg border border-waldgruen/30 bg-white px-4 py-2 font-body text-sm font-semibold text-waldgruen-dark transition-colors hover:bg-waldgruen/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-waldgruen"><span aria-live="polite">Text kopieren</span></button><span class="font-body text-sm text-warmgrau/80">Tipp ins Blatt, um etwas zu ändern.</span></div><aside class="mt-6 rounded-xl border border-waldgruen/20 bg-waldgruen/5 p-4"><h3 class="m-0 font-body text-base font-semibold text-waldgruen-dark">So wirkt dein Brief</h3><ul class="mt-2 mb-0 list-disc space-y-1 pl-5 font-body text-sm leading-relaxed text-warmgrau"><li>Kurz und klar: ein, höchstens zwei Anliegen.</li><li>Gut begründet: Warum ist es wichtig, und was soll sich ändern?</li><li>Persönlich: Schreib, was das Thema mit dir zu tun hat.</li></ul></aside><div class="mt-4 rounded-xl border border-warmgrau/25 bg-creme/70 p-4"><h3 class="m-0 font-body text-base font-semibold text-waldgruen-dark">Brief verbessern lassen</h3><p class="mt-1 font-body text-sm leading-relaxed text-warmgrau">Sag, was anders werden soll und warum. Das geht einmal, danach siehst du beide Fassungen.</p><label for="_R_3hH1_" class="mt-3 block font-body text-sm font-semibold text-waldgruen-dark">Was soll anders werden und warum?</label><div class="mt-2 flex flex-wrap gap-2"><button type="button" class="rounded-full border border-waldgruen/30 bg-white px-3 py-1 font-body text-sm text-waldgruen-dark transition-colors hover:bg-waldgruen/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-waldgruen">Kürzer</button><button type="button" class="rounded-full border border-waldgruen/30 bg-white px-3 py-1 font-body text-sm text-waldgruen-dark transition-colors hover:bg-waldgruen/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-waldgruen">Einfachere Wörter</button><button type="button" class="rounded-full border border-waldgruen/30 bg-white px-3 py-1 font-body text-sm text-waldgruen-dark transition-colors hover:bg-waldgruen/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-waldgruen">Klingt mehr nach mir</button><button type="button" class="rounded-full border border-waldgruen/30 bg-white px-3 py-1 font-body text-sm text-waldgruen-dark transition-colors hover:bg-waldgruen/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-waldgruen">Höflicher</button></div><textarea id="_R_3hH1_" maxLength="1000" rows="3" placeholder="Zum Beispiel: Der Brief klingt zu erwachsen. Er soll einfacher und mehr nach mir klingen." class="mt-2 block w-full rounded-lg border border-warmgrau/30 bg-white p-3 font-body text-base leading-relaxed text-warmgrau focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-waldgruen"></textarea><button type="button" aria-busy="false" class="mt-3 inline-flex min-h-12 w-full items-center justify-center rounded-lg bg-waldgruen px-4 py-2.5 font-body text-base font-bold text-creme transition-colors hover:bg-waldgruen-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-waldgruen focus-visible:ring-offset-2 disabled:cursor-wait disabled:opacity-70 sm:w-auto">Brief verbessern</button></div><div class="mt-4 rounded-xl border border-warmgrau/25 bg-creme/70 p-4"><h3 class="m-0 font-body text-sm font-semibold text-waldgruen-dark">Für den Umschlag</h3><address class="mt-1 font-body text-base not-italic leading-relaxed text-warmgrau"><span class="block">Maria Muster, MdB</span><span class="block">Deutscher Bundestag</span><span class="block">Platz der Republik 1</span><span class="block">11011 Berlin</span></address></div><div class="mt-4"><button type="button" disabled="" aria-busy="true" class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-lg bg-waldgruen px-4 py-2.5 font-body text-base font-bold text-creme transition-colors hover:bg-waldgruen-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-waldgruen focus-visible:ring-offset-2 disabled:cursor-wait disabled:opacity-70"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-[1.125rem] w-[1.125rem] shrink-0"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10 5 5 5-5"></path><path d="M12 15V3"></path></svg>PDF wird vorbereitet...</button><p class="mt-2 font-body text-sm leading-relaxed text-warmgrau">Speicher das PDF, bevor du die Seite schließt. Auf dem iPad: Teilen, dann „In Dateien sichern“.</p></div></section><div class="mt-3 flex items-center justify-center divide-x divide-warmgrau/20"><button type="button" aria-expanded="false" class="inline-flex cursor-pointer items-center gap-1.5 px-3 font-body text-sm text-warmgrau/55 transition-colors hover:text-warmgrau/75"><span class="underline underline-offset-2">So geht es weiter</span><span aria-hidden="true" class="text-[9px] transition-transform duration-300 ">▾</span></button></div></div><div><div class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden "><div class="mb-4 border-l-2 border-waldgruen/35 pl-4"><p class="font-body text-sm font-semibold text-waldgruen-dark">Mach diesen Brief zu deinem Brief.</p><p class="mt-1 font-body text-sm leading-relaxed text-warmgrau/75">Lies dir den Entwurf durch und pass Ton, Formulierungen oder einzelne Argumente so an, dass der Brief sich nach dir anfühlt. Der Entwurf ist ein Anfang, die Unterschrift ist deine.</p></div><ol class="space-y-3 pt-1"><li class="flex gap-3"><span class="flex-shrink-0 w-6 h-6 rounded-full bg-waldgruen/15 text-waldgruen font-body text-xs font-bold flex items-center justify-center mt-0.5">1</span><p class="font-body text-sm text-warmgrau leading-relaxed"><strong>Brief schreiben.</strong> Schreib deinen Brief von Hand, der Entwurf hilft dir dabei, und bleib bei deinem Schreibstil. Handgeschriebene Briefe werden im Bundestag tatsächlich gelesen und besprochen.</p></li><li class="flex gap-3"><span class="flex-shrink-0 w-6 h-6 rounded-full bg-waldgruen/15 text-waldgruen font-body text-xs font-bold flex items-center justify-center mt-0.5">2</span><p class="font-body text-sm text-warmgrau leading-relaxed"><strong>Adresse aufschreiben, Briefmarke drauf, ab zur Post.</strong> Die Anschrift steht unter deinem Entwurf.</p></li><li class="flex gap-3"><span class="flex-shrink-0 w-6 h-6 rounded-full bg-waldgruen/15 text-waldgruen font-body text-xs font-bold flex items-center justify-center mt-0.5">3</span><p class="font-body text-sm text-warmgrau leading-relaxed"><strong>Weitersagen.</strong> Je mehr Menschen schreiben, desto mehr Gewicht hat jeder einzelne Brief.</p></li></ol></div></div></div></section><aside class="min-w-0 border-t border-warmgrau/15 pt-6 md:-mt-1 md:col-start-2 md:row-span-2 md:row-start-1 md:border-l md:border-t-0 md:pl-8 md:pt-12"></aside></div>"
`;

