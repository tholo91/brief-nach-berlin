      <td width="34" height="30" style="width:34px;height:30px;vertical-align:middle;">
        <a href="https://www.instagram.com/thomas_duisi/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram" style="display:block;width:30px;height:30px;line-height:30px;mso-line-height-rule:exactly;background-color:transparent;border:0;text-align:center;text-decoration:none;">
