                <tr>
                  <td colspan="7" class="bnb-pad" style="padding:0 32px 8px;background-color:#ffffff;">
                    <div class="bnb-inner-pad" data-ai-generated="true" style="background-color:#FAF8F5;border:1px solid #E0DCD7;border-radius:4px;padding:24px;">
